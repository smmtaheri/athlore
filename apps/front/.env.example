# Coach Assistant Frontend — local development example
# Copy to `.env.local` if you need non-default values. Do not commit secrets.

# Backend API base including /api/v1 (no trailing slash required)
# Prefer a same-origin relative path in production builds (e.g. /api/v1).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Canonical production hosts used for absolute links.
VITE_PUBLIC_DOMAIN=athlore.ir
VITE_COACH_DOMAIN=coach.athlore.ir
VITE_STUDENT_DOMAIN=student.athlore.ir

# The only localhost fallback. Set to public, coach, or student when using Vite locally.
VITE_DEV_APP_SURFACE=coach

# Public coach self-registration (default false). Backend remains source of truth.
VITE_PUBLIC_REGISTRATION_ENABLED=false

# Set to true only for offline fixture/localStorage mode (not normal runtime)
# VITE_USE_MOCK_API=true
