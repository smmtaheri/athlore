# Copy to .env for local development. Never commit real secrets.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
DJANGO_DEBUG=true
PUBLIC_DOMAIN=athlore.ir
COACH_DOMAIN=coach.athlore.ir
STUDENT_DOMAIN=student.athlore.ir
DJANGO_ALLOWED_HOSTS=athlore.ir,coach.athlore.ir,student.athlore.ir,localhost,127.0.0.1
# Optional: use a throwaway DB file for local migrate experiments.
# DJANGO_DB_NAME=/tmp/coach_assistant_dev.sqlite3
# Static files root used by collectstatic / WhiteNoise under gunicorn.
# DJANGO_STATIC_ROOT=/app/staticfiles

# Public self-registration (default false). Prefer create_coach management command.
PUBLIC_REGISTRATION_ENABLED=false

# Demo fixtures (Arman/Mohammad). Opt-in only; never enable casually in production.
# LOAD_DEMO_FIXTURES=true

# Comma-separated origins for CSRF (needed when serving Django admin behind a proxy).
CSRF_TRUSTED_ORIGINS=https://athlore.ir,https://coach.athlore.ir,https://student.athlore.ir,http://localhost:5173,http://127.0.0.1:5173

CORS_ALLOWED_ORIGINS=https://athlore.ir,https://coach.athlore.ir,https://student.athlore.ir,http://localhost:5173,http://127.0.0.1:5173

# Database: leave DB_ENGINE unset (or sqlite) for SQLite; use postgresql for Postgres.
# DB_ENGINE=postgresql
# POSTGRES_DB=coach_assistant
# POSTGRES_USER=coach
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Optional PDF media root (defaults to ./media — gitignored)
# DJANGO_MEDIA_ROOT=/tmp/coach-assistant-media
PUBLIC_API_BASE_URL=https://athlore.ir/api/v1
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
PDF_SHARE_DEFAULT_DAYS=7
PDF_SHARE_MAX_DAYS=30
