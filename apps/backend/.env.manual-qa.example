# Local manual-QA environment for Coach Assistant Backend.
# Copy usage: source this file, or use scripts/start-local-qa.sh / scripts/reset-local-qa.sh
#
# This file is an EXAMPLE only. The real runtime uses gitignored .local/ paths.
# Do not point these at db.sqlite3.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-manual-qa-only-secret-key-change-me-32chars
PUBLIC_DOMAIN=athlore.localhost
COACH_DOMAIN=coach.athlore.localhost
STUDENT_DOMAIN=student.athlore.localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,athlore.localhost,coach.athlore.localhost,student.athlore.localhost
DJANGO_DB_NAME=.local/manual-qa.sqlite3
DJANGO_MEDIA_ROOT=.local/manual-media
PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PDF_SHARE_DEFAULT_DAYS=7
PDF_SHARE_MAX_DAYS=30
