  # Host-based gateway for the isolated staging stack. The variable in
  # proxy_pass makes Nginx resolve the target at request time, so production
  # Nginx remains healthy while staging is stopped and can return a clear 503.
  server {
    listen 80;
    server_name ${STAGE_PUBLIC_DOMAIN} ${STAGE_COACH_DOMAIN} ${STAGE_STUDENT_DOMAIN};

    # Successful responses carry the isolated stage Nginx security policy.
    # Appending the production policy would enforce two conflicting CSPs.
    client_max_body_size 110m;
    client_body_timeout 120s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;

    # Stage must always serve the current build, including its HTML entrypoint.
    proxy_hide_header Cache-Control;
    proxy_hide_header Expires;
    add_header Cache-Control "no-store" always;

    location / {
      resolver 127.0.0.11 valid=5s ipv6=off;
      set $stage_origin athlore-stage-nginx;
      proxy_intercept_errors on;
      error_page 502 503 504 = @stage_offline;
      include /etc/nginx/snippets/proxy-headers.conf;
      proxy_pass http://$stage_origin:80;
    }

    location @stage_offline {
      include /etc/nginx/snippets/security-headers.conf;
      include /etc/nginx/snippets/hsts.conf;
      default_type text/plain;
      add_header Cache-Control "no-store" always;
      add_header Retry-After 120 always;
      return 503 "Athlore staging is currently offline. Please start the staging environment and try again.\n";
    }
  }
