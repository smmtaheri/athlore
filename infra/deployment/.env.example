# Athlore Compose environment for local development.
# Copy to .env. Production uses the ParsPack CDN as the TLS terminator;
# the local origin listens on HTTP and accepts the forwarded scheme header.

TLS_MODE=external
PUBLIC_DOMAIN=athlore.localhost
COACH_DOMAIN=coach.athlore.localhost
STUDENT_DOMAIN=student.athlore.localhost
HTTP_PORT=18080

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=athlore.localhost,coach.athlore.localhost,student.athlore.localhost,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://athlore.localhost:18080,http://coach.athlore.localhost:18080,http://student.athlore.localhost:18080
CORS_ALLOWED_ORIGINS=http://athlore.localhost:18080,http://coach.athlore.localhost:18080,http://student.athlore.localhost:18080
PUBLIC_API_BASE_URL=http://athlore.localhost:18080/api/v1
PUBLIC_REGISTRATION_ENABLED=false
LOAD_DEMO_FIXTURES=false
JWT_REFRESH_DAYS=7
DJANGO_MEDIA_ROOT=/data/media

DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

POSTGRES_DB=coach_assistant
POSTGRES_USER=coach_assistant
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_ENGINE=postgresql
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
