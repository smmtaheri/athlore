# Athlore staging environment. Copy to .env.stage; stage-up.sh generates secrets.
# This host is a stage-only alias for public PDF share links, not a third DNS name.
TLS_MODE=external
PUBLIC_DOMAIN=stage.student.athlore.ir
COACH_DOMAIN=stage.coach.athlore.ir
STUDENT_DOMAIN=stage.student.athlore.ir
STAGE_COACH_DOMAIN=stage.coach.athlore.ir
STAGE_STUDENT_DOMAIN=stage.student.athlore.ir

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=stage.student.athlore.ir,stage.coach.athlore.ir
CSRF_TRUSTED_ORIGINS=https://stage.student.athlore.ir,https://stage.coach.athlore.ir
CORS_ALLOWED_ORIGINS=https://stage.student.athlore.ir,https://stage.coach.athlore.ir
PUBLIC_API_BASE_URL=https://stage.student.athlore.ir/api/v1
PUBLIC_REGISTRATION_ENABLED=false
LOAD_DEMO_FIXTURES=false
LOGIN_OTP_ENABLED=true
LOGIN_OTP_STATIC_CODE=1111
VITE_LOGIN_OTP_ENABLED=true
JWT_REFRESH_DAYS=7
DJANGO_MEDIA_ROOT=/data/media

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

POSTGRES_DB=athlore_stage
POSTGRES_USER=athlore_stage
POSTGRES_PASSWORD=
STAGE_IMAGE_TAG=latest
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
