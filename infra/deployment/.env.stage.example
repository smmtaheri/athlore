# Athlore staging environment. Copy to .env.stage; stage-up.sh generates secrets.
# ParsPack sends all three stage hostnames to the same production origin IP.
TLS_MODE=external
PUBLIC_DOMAIN=stage.athlore.ir
COACH_DOMAIN=stage.coach.athlore.ir
STUDENT_DOMAIN=stage.student.athlore.ir
STAGE_PUBLIC_DOMAIN=stage.athlore.ir
STAGE_COACH_DOMAIN=stage.coach.athlore.ir
STAGE_STUDENT_DOMAIN=stage.student.athlore.ir

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=stage.athlore.ir,stage.coach.athlore.ir,stage.student.athlore.ir
CSRF_TRUSTED_ORIGINS=https://stage.athlore.ir,https://stage.coach.athlore.ir,https://stage.student.athlore.ir
CORS_ALLOWED_ORIGINS=https://stage.athlore.ir,https://stage.coach.athlore.ir,https://stage.student.athlore.ir
PUBLIC_API_BASE_URL=https://stage.athlore.ir/api/v1
PUBLIC_REGISTRATION_ENABLED=false
LOAD_DEMO_FIXTURES=false
LOGIN_OTP_ENABLED=true
LOGIN_OTP_PROVIDER=najva
# Shared Stage uses Najva. Automated E2E mock settings belong only to isolated tests.
SMS_BACKEND=najva
NAJVA_API_KEY=
NAJVA_SENDER=100005676
# Approved template NAME (not its numeric ID); it must include %token.
NAJVA_TEMPLATE=athlore_otp
PROGRAM_READY_SMS_ENABLED=true
NAJVA_PROGRAM_READY_TEMPLATE=athlore_program_ready
VISIT_FINALIZED_SMS_ENABLED=true
NAJVA_VISIT_FINALIZED_TEMPLATE=athlore_visit_finalized
VITE_LOGIN_OTP_ENABLED=true
JWT_REFRESH_DAYS=7
DJANGO_MEDIA_ROOT=/data/media

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

POSTGRES_DB=athlore_stage
POSTGRES_USER=athlore_stage
POSTGRES_PASSWORD=
STAGE_IMAGE_TAG=latest
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
