# Athlore production environment.
# Copy to .env on the server and fill the secret values. Do not commit .env.
# ParsPack must proxy all three names to this origin and terminate HTTPS at
# the CDN: athlore.ir, coach.athlore.ir, student.athlore.ir.

TLS_MODE=external
PUBLIC_DOMAIN=athlore.ir
COACH_DOMAIN=coach.athlore.ir
STUDENT_DOMAIN=student.athlore.ir
HTTP_PORT=80

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=athlore.ir,coach.athlore.ir,student.athlore.ir
CSRF_TRUSTED_ORIGINS=https://athlore.ir,https://coach.athlore.ir,https://student.athlore.ir
CORS_ALLOWED_ORIGINS=https://athlore.ir,https://coach.athlore.ir,https://student.athlore.ir
PUBLIC_API_BASE_URL=https://athlore.ir/api/v1
PUBLIC_REGISTRATION_ENABLED=false
LOAD_DEMO_FIXTURES=false
DJANGO_MEDIA_ROOT=/data/media

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

POSTGRES_DB=coach_assistant
POSTGRES_USER=coach_assistant
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_ENGINE=postgresql
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
